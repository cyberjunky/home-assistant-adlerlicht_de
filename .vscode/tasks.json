{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Home Assistant on port 8123",
      "type": "shell",
      "command": "scripts/develop",
      "problemMatcher": []
    },
    {
      "label": "Setup",
      "type": "shell",
      "command": "scripts/setup",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "scripts/lint",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pytest",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
